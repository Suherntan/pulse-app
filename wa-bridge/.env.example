# Copy this file to ".env" (same folder) and fill in the first two lines.

# Your Apps Script web app link (the one ending in /exec)
PULSE_API_URL=https://script.google.com/macros/s/PASTE_YOURS_HERE/exec

# Same text as the Script property WA_BRIDGE_SECRET in Apps Script
WA_BRIDGE_SECRET=

# --- Safety limits (the defaults are deliberately gentle) ---
# Most messages sent per day. Start LOW on a new number (10), raise slowly.
DAILY_CAP=30
# Wait a random time between messages, in seconds
MIN_DELAY_SEC=45
MAX_DELAY_SEC=120
# Only send between these hours (this computer's clock, 24-hour)
SEND_FROM_HOUR=9
SEND_TO_HOUR=20
# How often to look for new messages, in seconds
POLL_SEC=60
